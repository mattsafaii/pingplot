{
  "name": "pingplot",
  "version": "1.0.0",
  "description": "Turn a CSV or JSON file into a chart — PNG by default, SVG or self-contained HTML on request — via Observable Plot.",
  "main": "src/cli.js",
  "scripts": {
    "test": "vitest run",
    "prepublishOnly": "pnpm test"
  },
  "keywords": [
    "chart",
    "plot",
    "cli",
    "observable-plot",
    "png",
    "svg",
    "html",
    "data-viz",
    "csv",
    "json"
  ],
  "author": "Matt Safaii",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "catalog.md",
    "README.md",
    "LICENSE"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "dependencies": {
    "@observablehq/plot": "^0.6.17",
    "d3": "^7.9.0",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  },
  "bin": {
    "pingplot": "src/cli.js"
  }
}